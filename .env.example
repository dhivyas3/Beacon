# QA Hub configuration. Copy to `.env` and adjust. Never commit `.env`.
# Every variable below is read by the api and/or worker; the web app needs none.

# ---- Runtime ---------------------------------------------------------------------------------
# development | test | production. `development` enables pretty logs.
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---- Infrastructure --------------------------------------------------------------------------
# PostgreSQL 16. With docker compose this is set for you.
DATABASE_URL=postgresql://qahub:qahub@localhost:5432/qahub
# Password used by the compose postgres service (compose only).
POSTGRES_PASSWORD=qahub
# Redis 7, used by BullMQ.
REDIS_URL=redis://localhost:6379
# Where screenshots and PDFs are stored on local disk.
STORAGE_DIR=./data/storage
# Redis key prefix for BullMQ queues. Lets several environments share one Redis.
QUEUE_PREFIX=qahub

# ---- Public URLs -----------------------------------------------------------------------------
# Base URL users open in the browser. Used to build statusUrl, reportUrl and callback links.
PUBLIC_URL=http://localhost:8080
# Host port for the web container (compose only).
WEB_PORT=8080

# ---- API -------------------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
# Set true when served over HTTPS so the session cookie is marked Secure.
COOKIE_SECURE=false
# Session lifetime in hours.
SESSION_TTL_HOURS=168
# Requests per minute allowed per API key or session.
RATE_LIMIT_PER_MINUTE=120

# ---- Callbacks -------------------------------------------------------------------------------
# HMAC-SHA256 key for the X-QAHub-Signature header on callbacks. 16+ characters.
# Generate one with: openssl rand -hex 32
WEBHOOK_SIGNING_SECRET=change-me-to-a-long-random-string

# ---- Scan engine -----------------------------------------------------------------------------
# Maximum pages discovered per scan.
MAX_PAGES=2000
# Pages processed in parallel per scan (Playwright pages).
PAGE_CONCURRENCY=5
# Parallel HEAD/GET requests when verifying internal links.
LINK_CONCURRENCY=10
# Parallel requests for external links, with a delay between requests to the same host.
EXTERNAL_LINK_CONCURRENCY=3
EXTERNAL_HOST_DELAY_MS=500
# Scans allowed to run at once. Others wait as `queued`.
MAX_CONCURRENT_SCANS=3
# Requests per second one scan may send to the target site.
SCAN_RATE_LIMIT_RPS=10
# Comma separated hostname patterns that mean "not production".
# `.netlify.app` matches a suffix, `staging.` matches a leading label, `localhost` matches exactly.
STAGING_PATTERNS=localhost,staging.,dev.,.netlify.app,.vercel.app,.gatsbyjs.io
# Comma separated checks used when a scan does not specify any.
DEFAULT_CHECKS=images,links,staging-urls,forms,page-health,seo
# Email address entered into forms in `submit` mode. Use an address you control.
FORM_TEST_EMAIL=qa-test@example.com

# ---- Security --------------------------------------------------------------------------------
# TEST ONLY. Allows scanning loopback and private addresses, which the SSRF guard blocks by
# default. Enable it only to scan the local fixture site. Never set it in production.
ALLOW_LOCAL_TARGETS=false

# ---- First admin (used by `pnpm db:seed`) ----------------------------------------------------
SEED_ADMIN_EMAIL=admin@example.com
# At least 12 characters.
SEED_ADMIN_PASSWORD=change-me-please-123
SEED_ADMIN_NAME=Admin

# ---- Local development without Docker --------------------------------------------------------
# Path to a redis-server binary for `pnpm dev:services` and the test suite when Redis is not on PATH.
# Defaults to a copy under .tools/redis if present.
# REDIS_SERVER_BIN=

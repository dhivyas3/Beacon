// Beacon data model. IDs are prefixed nanoids generated in application code (see @beacon/shared newId).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  member
}

enum ScanStatus {
  queued
  discovering
  running
  completed
  failed
  cancelled
}

/// Sub-stage while a scan has status `running`.
enum ScanStage {
  pages
  links
  finalising
}

enum FormMode {
  detect
  validate_only
  submit
}

enum CheckFrequency {
  manual
  daily
  weekly
  monthly
}

enum PageSelectionMode {
  full
  static_list
  random_sample
}

enum TriggerType {
  manual_ui
  manual_api
  scheduled
  n8n
  monday
}

enum PageStatus {
  pending
  done
  error
}

enum Severity {
  critical
  warning
  info
}

enum IssueState {
  open
  ignored
}

enum LinkKind {
  internal
  external
}

enum LinkState {
  pending
  done
}

model User {
  id           String   @id
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(member)
  createdAt    DateTime @default(now())

  sessions       Session[]
  apiKeys        ApiKey[]
  allowedDomains AllowedDomain[]
  scans          Scan[]
  websites       Website[]
}

model Session {
  id        String   @id
  userId    String
  tokenHash String   @unique
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ApiKey {
  id          String    @id
  name        String
  /// First characters of the raw key, shown in the UI.
  prefix      String
  /// sha256 of the raw key. The raw key is never stored.
  keyHash     String    @unique
  scopes      String[]
  createdById String?
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  scans     Scan[]
}

model AllowedDomain {
  id          String   @id
  /// Exact hostname, or `*.example.com` to match the apex and every subdomain.
  hostname    String   @unique
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)
}

/// Gap-free per-hostname run numbers.
model HostnameCounter {
  hostname String @id
  last     Int    @default(0)
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// A site that is monitored: checked on a schedule, with the report emailed to its recipients.
model Website {
  id       String @id
  name     String
  url      String
  /// One website per hostname, so a hostname's history is unambiguous.
  hostname String @unique
  ownerId  String

  checkFrequency     CheckFrequency @default(weekly)
  /// 0 is Sunday. Used by weekly.
  scheduleDayOfWeek  Int?
  /// 1 to 31, clamped to the last day of shorter months. Used by monthly.
  scheduleDayOfMonth Int?
  scheduleHourUtc    Int            @default(6)

  pageSelectionMode PageSelectionMode @default(random_sample)
  /// Exactly these pages are checked by static_list.
  staticPageUrls    String[]
  /// Always included, on top of the homepage, by random_sample.
  pinnedPageUrls    String[]
  /// Pages checked by random_sample, homepage and pinned pages included.
  sampleSize        Int               @default(10)
  enabledChecks     String[]
  formMode          FormMode          @default(validate_only)

  isActive     Boolean   @default(true)
  lastCheckAt  DateTime?
  nextCheckAt  DateTime?
  /// Why the last scheduled run could not start. Cleared by the next run that does.
  lastRunError String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  owner      User               @relation(fields: [ownerId], references: [id])
  recipients WebsiteRecipient[]
  scans      Scan[]

  @@index([isActive, nextCheckAt])
}

model WebsiteRecipient {
  id        String   @id
  websiteId String
  email     String
  name      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, email])
}

model Scan {
  id        String     @id
  url       String
  hostname  String
  runNumber Int
  status    ScanStatus @default(queued)
  stage     ScanStage?
  checks    String[]
  formMode  FormMode   @default(detect)

  callbackUrl    String?
  /// Stored and echoed back untouched.
  metadata       Json?
  /// `${actorId}:${Idempotency-Key header}`.
  idempotencyKey String? @unique

  triggeredByUserId   String?
  triggeredByApiKeyId String?
  triggeredByType     TriggerType @default(manual_api)

  /// Set when this scan is a check of a registered website. Null for a one-off scan.
  websiteId         String?
  /// The completed scan this one is compared with, set when it completes.
  previousScanId    String?
  /// Page selection for this run, copied from the website (or the request) when it is created.
  pageSelectionMode PageSelectionMode @default(full)
  staticPageUrls    String[]
  pinnedPageUrls    String[]
  sampleSize        Int               @default(10)

  // Aggregate counters, so the dashboard list is a single cheap query.
  pagesFound    Int  @default(0)
  pagesTotal    Int  @default(0)
  pagesDone     Int  @default(0)
  linksTotal    Int  @default(0)
  linksChecked  Int  @default(0)
  criticalCount Int  @default(0)
  warningCount  Int  @default(0)
  passedCount   Int  @default(0)
  healthScore   Int?

  // Progress maths (see docs/DECISIONS.md).
  avgPageMs       Float?
  avgLinkMs       Float?
  pageConcurrency Int    @default(5)
  linkConcurrency Int    @default(10)
  seedDurationMs  Int?
  progressPercent Int    @default(0)

  errorMessage String?
  heartbeatAt  DateTime?
  createdAt    DateTime  @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?

  triggeredByUser   User?    @relation(fields: [triggeredByUserId], references: [id], onDelete: SetNull)
  triggeredByApiKey ApiKey?  @relation(fields: [triggeredByApiKeyId], references: [id], onDelete: SetNull)
  website           Website? @relation(fields: [websiteId], references: [id], onDelete: SetNull)
  previousScan      Scan?    @relation("ScanHistory", fields: [previousScanId], references: [id], onDelete: SetNull)
  followingScans    Scan[]   @relation("ScanHistory")

  pages      ScanPage[]
  issues     ScanIssue[]
  results    CheckResult[]
  deliveries WebhookDelivery[]
  links      ScanLink[]

  @@unique([hostname, runNumber])
  @@index([hostname, status])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([status, heartbeatAt])
  @@index([websiteId, status, finishedAt])
}

model ScanPage {
  id            String     @id
  scanId        String
  url           String
  status        PageStatus @default(pending)
  httpStatus    Int?
  durationMs    Int?
  /// Groups structurally similar pages, for example `/properties/:slug`.
  template      String?
  criticalCount Int        @default(0)
  warningCount  Int        @default(0)

  scan    Scan             @relation(fields: [scanId], references: [id], onDelete: Cascade)
  issues  ScanIssue[]
  sources ScanLinkSource[]

  @@unique([scanId, url])
  @@index([scanId, status])
}

model ScanIssue {
  id             String     @id
  scanId         String
  pageId         String?
  checkType      String
  severity       Severity
  /// Hash used to group identical issues across pages.
  fingerprint    String
  message        String
  selector       String?
  resourceUrl    String?
  evidence       Json       @default("{}")
  screenshotPath String?
  state          IssueState @default(open)
  ignoreNote     String?
  createdAt      DateTime   @default(now())

  scan Scan      @relation(fields: [scanId], references: [id], onDelete: Cascade)
  page ScanPage? @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([scanId, severity])
  @@index([scanId, fingerprint])
  @@index([scanId, checkType])
  @@index([scanId, createdAt])
  @@index([pageId])
}

model CheckResult {
  id           String @id
  scanId       String
  checkType    String
  pagesChecked Int    @default(0)
  issuesFound  Int    @default(0)

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@unique([scanId, checkType])
}

/// Every unique link found during a scan, verified once (global de-duplication).
model ScanLink {
  id           String    @id
  scanId       String
  url          String
  kind         LinkKind
  state        LinkState @default(pending)
  httpStatus   Int?
  redirectHops Int       @default(0)
  finalUrl     String?
  error        String?
  checkedAt    DateTime?

  scan    Scan             @relation(fields: [scanId], references: [id], onDelete: Cascade)
  sources ScanLinkSource[]

  @@unique([scanId, url])
  @@index([scanId, state])
}

/// Which pages reference a link, so a broken link becomes one issue per affected page.
model ScanLinkSource {
  id       String  @id
  linkId   String
  pageId   String
  selector String?
  text     String?

  link ScanLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  page ScanPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([linkId, pageId])
  @@index([pageId])
}

model WebhookDelivery {
  id             String    @id
  scanId         String
  event          String
  url            String
  attempt        Int
  responseStatus Int?
  error          String?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
}

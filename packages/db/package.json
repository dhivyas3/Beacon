{
  "name": "@beacon/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "migrate": "node scripts/with-env.mjs prisma migrate deploy",
    "migrate:dev": "node scripts/with-env.mjs prisma migrate dev",
    "seed": "node scripts/with-env.mjs tsx src/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@beacon/shared": "workspace:*",
    "zod": "^4.6.5",
    "@node-rs/argon2": "^2.0.2"
  },
  "devDependencies": {
    "@beacon/testkit": "workspace:*",
    "@types/node": "^22.20.4",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}

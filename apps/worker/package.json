    "@beacon/net": "workspace:*",
    "@beacon/shared": "workspace:*",
    "@beacon/storage": "workspace:*",
    "bullmq": "^5.81.5",
    "ioredis": "^5.11.1",
    "pino": "^9.14.0",
    "playwright": "^1.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@beacon/fixtures": "workspace:*",
    "@beacon/testkit": "workspace:*",
    "@types/node": "^22.20.4",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
